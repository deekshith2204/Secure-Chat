# Copy this to .env and fill in your values

# Database — SQLite (default) or PostgreSQL (Azure)
DATABASE_URL=sqlite:///./securechat.db
# DATABASE_URL=postgresql://user:password@localhost/securechat

# Used to sign browser session tokens after OTP verification
SESSION_SECRET=replace_with_a_long_random_secret

# In-memory rate limits. Use a shared store/proxy limiter for multi-instance production.
OTP_REQUEST_LIMIT=5
OTP_VERIFY_LIMIT=10
PUBLIC_READ_LIMIT=60
PROTECTED_API_LIMIT=120
RATE_LIMIT_WINDOW_SECONDS=900
API_RATE_LIMIT_WINDOW_SECONDS=60

# Twilio SendGrid for OTP emails (leave blank for dev console output)
SENDGRID_API_KEY=
SENDGRID_FROM=dthadvai@gmail.com

